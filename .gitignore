# Go
bin/
.cache/
*.test
*.out
# 编辑器/手工留下的源码备份，不是构建产物也不该进库
*.bak

# Frontend
web/node_modules/
web/dist/
web/tsconfig.tsbuildinfo
# Cursor bridge JS deps (npm install in scripts/cursor-bridge)
scripts/cursor-bridge/node_modules/
# Cursor bridge 预编译产物（deploy-linux.sh 构建期生成）
scripts/cursor-bridge/dist/

# Desktop (Wails)
desktop/build/bin/
desktop/frontend/dist/
# web/dist 的副本：打包前由 scripts/bundle-desktop-assets.sh 生成，随 -tags desktop_ui 内嵌
desktop/assets/
desktop/frontend/node_modules/
desktop/frontend/package.json.md5
desktop/frontend/wailsjs/
.cache/app-bundle/
.cache/packaged_resolve_check.go

# Logs
*.log

# OS / editor
.DS_Store
.vscode/
.idea/

# Local env
.env
.env.*
.gateway/

# Local editor history
.history/

# Local runtime data (providers, OAuth tokens, SQLite, tunnels)
*.db
*.db-shm
*.db-wal
**/gateway.db*
web/.history/
desktop/frontend/.history/

# Packaged / local cloudflare artifacts if ever copied into repo
**/.cloudflared/
**/cert.pem
**/tunnel-config.yml
!internal/tunnel/quick_tunnel_config.yml
# 审查产物：账本与报告必须进版本控制（它们是对抗式审查的唯一事实源，
# 曾因整个目录被删而丢失）。证据目录（探针、日志、DB）体积大，仍忽略。
.workbuddy/*
!.workbuddy/reviews/
.workbuddy/reviews/*
!.workbuddy/reviews/LEDGER.md
!.workbuddy/reviews/round*-agent-code-review.md

# Trellis & agent metadata
.trellis/
.agent/
.codegraph/
.zcode/
.ui-audit/
# Agent 草稿/计划目录：只留在本地，不进库
.superpowers/
docs/superpowers/

# 构建产物
*.exe
bin/

# 发版产物
/dist/
